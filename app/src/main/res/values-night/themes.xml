<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.HellStation" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 어두운 배경에는 밝은 상태바 글씨 -->
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowSplashScreenBackground" tools:targetApi="s">
            @color/ic_launcher_background
        </item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">
            @drawable/ic_launcher_foreground
        </item>
    </style>
</resources>
